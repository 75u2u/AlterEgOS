# AlterEgOS, x86_64 (QEMU q35 now, PC hardware later)
BR2_x86_64=y
BR2_x86_64_v2=y

# musl: small static binaries, no glibc surprises in PID 1
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Everything linked static: no shared-library setup to break
BR2_STATIC_LIBS=y

# ccache: the second build of the toolchain and kernel is minutes, not an hour
BR2_CCACHE=y

# No init system from Buildroot: our package installs /sbin/init
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="alteregos"
BR2_TARGET_GENERIC_ISSUE=""
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ALTEREGOS_PATH)/board/alteregos/rootfs-overlay"

# Escape hatch on tty2 and a few diagnostics tools; nothing else
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ALTEREGOS_PATH)/board/alteregos/busybox.fragment"

# The OS itself
BR2_PACKAGE_ALTEREGOS=y

# Kernel: LTS, arch defconfig + our fragment (virtio, btrfs, serial console)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.30"
# The toolchain is built against the same kernel series (without these two
# lines Buildroot expects 2.6.x headers and the toolchain build stops)
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ALTEREGOS_PATH)/board/alteregos/linux-common.fragment $(BR2_EXTERNAL_ALTEREGOS_PATH)/board/alteregos/linux-x86_64.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y

# Root filesystem: an initramfs, both as a separate rootfs.cpio.gz (QEMU
# -kernel/-initrd) and embedded into bzImage so the kernel alone is a bootable
# EFI application. A btrfs root disk arrives on day 5.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_ROOTFS_TAR is not set

# USB / disk image for UEFI PCs (board/alteregos/genimage-efi.cfg)
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ALTEREGOS_PATH)/board/alteregos/post-image.sh"
