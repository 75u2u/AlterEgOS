# Shared by every AlterEgOS target. Appended on top of the arch defconfig.

# init needs these mounted by hand, so they must be built in
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=n
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y

# initramfs boot (day 1) and the btrfs root that replaces it (day 5)
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# virtio for QEMU; harmless on real hardware
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# networking the agent will need from day 2 (DHCP, HTTPS)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# /proc/config.gz: the agent can read how its own kernel was built
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# the agent's exec/build tools will use these
CONFIG_SECCOMP=y
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y

# the EFI System Partition: the agent keeps its API key and what it learned
# in alterego/ on the FAT partition it booted from
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y

# a correct clock at boot, or TLS certificate checks fail
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"

# The screen: a framebuffer for the desktop (src/screen) and keyboards and
# mice through evdev. DRM drivers expose the framebuffer as /dev/fb0 through
# the fbdev emulation; virtio-gpu / virtio-input are what QEMU offers.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
